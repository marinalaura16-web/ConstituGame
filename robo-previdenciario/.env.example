# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ROBO_MODELO=claude-opus-5
ROBO_ESFORCO=high
# 1 = só publicação + IA + prazo; 2 = liga Drive, senha gov.br e planilha do Advbox
ROBO_ETAPA=1

# --- DJEN: OABs do escritório (separadas por vírgula) ---
DJEN_OABS=12345/PR,67890/SC

# --- Dados ---
ROBO_BANCO=dados/robo.db
ADVBOX_PLANILHA=C:/Escritorio/advbox_clientes.xlsx

# --- Google Drive ---
# local = pasta sincronizada pelo "Google Drive para computador" (mais simples)
DRIVE_MODO=local
DRIVE_PASTA_LOCAL=G:/Drives compartilhados/Clientes
# api = Google Drive API com conta de serviço
# DRIVE_MODO=api
# DRIVE_PASTA_CLIENTES_ID=1AbC...
# GOOGLE_CREDENCIAIS=config/conta-servico.json

# --- Painel ---
PAINEL_SENHA=troque-esta-senha
PAINEL_URL=http://192.168.0.10:8000

# --- E-mail do resumo diário ---
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=robo@escritorio.com.br
SMTP_SENHA=senha-de-app
SMTP_REMETENTE=robo@escritorio.com.br
